{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --port 4173 --strictPort",
      "startServerReadyPattern": "Local",
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4173/#/",
        "http://localhost:4173/#/customer",
        "http://localhost:4173/#/rider",
        "http://localhost:4173/#/hub",
        "http://localhost:4173/#/resale",
        "http://localhost:4173/#/impact",
        "http://localhost:4173/#/pilot",
        "http://localhost:4173/#/demo"
      ],
      "settings": { "formFactor": "mobile", "chromeFlags": "--headless=new --no-sandbox" }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lhci-report" }
  }
}
